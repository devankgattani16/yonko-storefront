let cart=JSON.parse(localStorage.getItem("yonko-cart")||"[]"),activeFilter="All",selectedSize="L";
const $=s=>document.querySelector(s);
function money(n){return "₹"+n.toLocaleString("en-IN")}
function renderProducts(){let list=products.filter(p=>(activeFilter==="All"||p.anime===activeFilter)&&(`${p.name} ${p.anime}`).toLowerCase().includes($("#search").value.toLowerCase()));$("#products").innerHTML=list.map(p=>`<article class="product-card" data-id="${p.id}"><div class="product-visual"><span class="tag">${p.tag}</span><div class="tee"><span>${p.mark}</span></div><button class="quick-add" data-quick="${p.id}">QUICK ADD +</button></div><div class="product-info"><div><h3>${p.name}</h3><p>${p.anime} · Relaxed fit</p></div><span class="price">${money(p.price)}</span></div></article>`).join("")||'<p class="empty">No products match your search.</p>'}
function save(){localStorage.setItem("yonko-cart",JSON.stringify(cart));renderCart()}
function add(id,size="L"){let item=cart.find(x=>x.id===id&&x.size===size);item?item.qty++:cart.push({id,size,qty:1});save();toast("Added to your bag")}
function renderCart(){let count=cart.reduce((a,b)=>a+b.qty,0),total=cart.reduce((a,b)=>a+products.find(p=>p.id===b.id).price*b.qty,0);$("#cartCount").textContent=count;$("#drawerCount").textContent=`(${count})`;$("#subtotal").textContent=money(total);$("#cartItems").innerHTML=cart.length?cart.map((x,i)=>{let p=products.find(p=>p.id===x.id);return `<div class="cart-row"><div class="mini-visual">${p.mark}</div><div><h4>${p.name}</h4><p>Size: ${x.size} · ${money(p.price)}</p><div class="qty"><button data-dec="${i}">−</button><span>${x.qty}</span><button data-inc="${i}">+</button></div></div><button class="close" data-remove="${i}">×</button></div>`}).join(""):'<p class="empty">Your bag is waiting for something legendary.</p>'}
function openCart(){$("#overlay").classList.add("show");$("#cartDrawer").classList.add("open")}
function closeLayers(){$("#overlay").classList.remove("show");$("#cartDrawer").classList.remove("open");document.querySelectorAll(".modal").forEach(m=>m.classList.remove("open"))}
function toast(msg){$("#toast").textContent=msg;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1900)}
function showProduct(id){let p=products.find(x=>x.id===id);selectedSize="L";$("#modalContent").innerHTML=`<div class="modal-product"><div class="product-visual"><div class="tee"><span>${p.mark}</span></div></div><div><p class="eyebrow">${p.anime.toUpperCase()} / YONKO ORIGINALS</p><h2>${p.name}</h2><strong>${money(p.price)}</strong><p>${p.desc}</p><p class="eyebrow">SELECT SIZE</p><div class="size-options">${["S","M","L","XL","XXL"].map(s=>`<button data-size="${s}" class="${s===selectedSize?"selected":""}">${s}</button>`).join("")}</div><button class="btn btn-red full" id="modalAdd">ADD TO BAG — ${money(p.price)}</button><p>Demo catalogue item. Replace with your original product artwork before launch.</p></div></div>`;$("#productModal").classList.add("open");$("#overlay").classList.add("show");$("#modalAdd").onclick=()=>{add(id,selectedSize);closeLayers()};document.querySelectorAll("[data-size]").forEach(b=>b.onclick=()=>{selectedSize=b.dataset.size;document.querySelectorAll("[data-size]").forEach(x=>x.classList.toggle("selected",x===b))})}
$("#products").addEventListener("click",e=>{let q=e.target.closest("[data-quick]");if(q){e.stopPropagation();add(Number(q.dataset.quick))}else{let c=e.target.closest("[data-id]");if(c)showProduct(Number(c.dataset.id))}});
$("#filters").addEventListener("click",e=>{let b=e.target.closest("[data-filter]");if(!b)return;activeFilter=b.dataset.filter;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));renderProducts()});
document.querySelectorAll(".collection-card").forEach(c=>c.addEventListener("click",()=>{activeFilter=c.dataset.filter;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x.dataset.filter===activeFilter));renderProducts()}));
$("#search").addEventListener("input",renderProducts);$("#cartOpen").onclick=openCart;$("#cartClose").onclick=closeLayers;$("#overlay").onclick=closeLayers;$("#modalClose").onclick=closeLayers;$("#accountBtn").onclick=()=>{$("#accountModal").classList.add("open");$("#overlay").classList.add("show")};$("#accountClose").onclick=closeLayers;
$("#cartItems").addEventListener("click",e=>{let i=Number(e.target.dataset.inc??e.target.dataset.dec??e.target.dataset.remove);if(e.target.dataset.inc!==undefined)cart[i].qty++;if(e.target.dataset.dec!==undefined){cart[i].qty--;if(cart[i].qty<=0)cart.splice(i,1)}if(e.target.dataset.remove!==undefined)cart.splice(i,1);save()});
$("#checkoutBtn").onclick=()=>toast("Checkout activates after ShopNx backend and payment setup.");
$("#newsletter").onsubmit=e=>{e.preventDefault();toast("Thanks! Newsletter signup needs a mailing-list connection.");e.target.reset()};
$("#menuBtn").onclick=()=>$("#nav").classList.toggle("open");
renderProducts();renderCart();
